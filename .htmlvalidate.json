{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off",
    "long-title": "off",
    "tel-non-breaking": [
      "error",
      {
        "characters": [
          {
            "pattern": " ",
            "replacement": "&nbsp;",
            "description": "non-breaking space"
          }
        ]
      }
    ]
  }
}
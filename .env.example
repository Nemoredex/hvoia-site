# Пример настроек сервера. Скопируйте в .env на хостинге и заполните. Сам .env в git не попадает.

# Боевой домен (по умолчанию https://www.hvoia-event.ru)
# SITE=https://www.hvoia-event.ru

# --- Заявки в Telegram ---
# Бот создаётся у @BotFather, chat_id — личный чат или группа менеджеров.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Копия заявок на почту (необязательно) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_EMAIL_TO=hvoia@internet.ru

# --- Яндекс SmartCaptcha (необязательно) ---
# Ключи из консоли Yandex Cloud. Публичный ключ нужен при сборке, серверный — на сервере.
PUBLIC_SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Онлайн-бронирование (необязательно) ---
# Адрес страницы модуля TravelLine/Bnovo. Если пусто — «Проверить даты» переносит даты в форму заявки.
PUBLIC_BOOKING_URL=

# --- Яндекс Метрика (необязательно) ---
PUBLIC_METRIKA_ID=

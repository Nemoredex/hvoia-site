---
/**
 * Каркас всех страниц. SEO — в SeoHead. Шапка стоит внутри Hero/PageHero (как в прототипе),
 * подвал и мобильная панель — здесь.
 */
import '@fontsource/prata/cyrillic-400.css';
import '@fontsource/prata/latin-400.css';
import '@fontsource/onest/cyrillic-400.css';
import '@fontsource/onest/cyrillic-500.css';
import '@fontsource/onest/cyrillic-600.css';
import '@fontsource/onest/latin-400.css';
import '@fontsource/onest/latin-500.css';
import '@fontsource/onest/latin-600.css';

import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import Metrika from '../components/Metrika.astro';
import SeoHead, { type JsonLd } from '../components/SeoHead.astro';
import type { PageSeo } from '../data/seo';

interface Props {
  /** Запись из src/data/seo.ts. */
  seo: PageSeo;
  jsonLd?: JsonLd[];
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
  /** Главное действие мобильной панели: якорь формы на странице. */
  mbar?: { href: string; label: string };
}

const { seo, jsonLd, ogImage, ogType, mbar = { href: '#contacts', label: 'Заявка' } } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <SeoHead seo={seo} jsonLd={jsonLd} ogImage={ogImage} ogType={ogType} />
    {/* Для preload LCP-картинки и шрифта первого экрана (этапы 4 и 8). */}
    <slot name="head" />
    <Metrika />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <div class="page">
      {/* Как в прототипе: Hero/PageHero с шапкой внутри — первый блок <main>. */}
      <main id="main">
        <slot />
      </main>
      <Footer />
      <MobileBar ctaHref={mbar.href} ctaLabel={mbar.label} />
    </div>
  </body>
</html>

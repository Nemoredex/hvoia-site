---
/**
 * Фото первого экрана — LCP-картинка: eager + fetchpriority="high", sizes=100vw (как в прототипе).
 * Ширины 640…2560 с шагом, чтобы на 1440 px браузер брал 1600, а не 1920 (минус ~30% веса).
 * Качество 72: фото лежит под затемнением .hero__shade, разницы не видно.
 * Для главной — арт-дирекция: вертикальный кадр на телефоне (<source media>).
 * Preload не нужен: <img> стоит в начале HTML, его сразу находит preload-сканер браузера,
 * а preload при арт-дирекции рискует скачать оба кадра.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HeroImage } from '../data/images';

interface Props {
  image: HeroImage;
}
const { image } = Astro.props;

async function srcset(src: ImageMetadata, widths: number[]) {
  const list = widths.filter((w) => w < src.width).concat(src.width);
  const imgs = await Promise.all(list.map((width) => getImage({ src, width, format: 'webp', quality: 72 })));
  return {
    srcset: imgs.map((img, i) => `${img.src} ${list[i]}w`).join(', '),
    fallback: imgs.find((_, i) => list[i] === 1600) ?? imgs[imgs.length - 1],
  };
}

const desktop = await srcset(image.src, [640, 960, 1280, 1600, 1920]);
const mobile = image.mobile ? await srcset(image.mobile, [640, 900, 1200]) : null;
const style = image.position ? `object-position:${image.position}` : undefined;
---

<picture>
  {mobile && image.mobile && (
    <source media="(max-width: 760px)" srcset={mobile.srcset} sizes="100vw" width={image.mobile.width} height={image.mobile.height} />
  )}
  <img
    class="hero__img"
    src={desktop.fallback.src}
    srcset={desktop.srcset}
    sizes="100vw"
    alt={image.alt}
    width={image.src.width}
    height={image.src.height}
    fetchpriority="high"
    loading="eager"
    decoding="async"
    style={style}
  />
</picture>

---
/** Контакты + Яндекс Карта организации (грузится, когда блок подходит к экрану). */
import '../styles/parts/contacts.css';
import Button from './Button.astro';
import LazyFrame from './LazyFrame.astro';
import company from '../data/company.json';

const { address, phones, messengers } = company;
import { phoneText } from '../lib/format';
---

<section class="section section--tight container">
  <div class="contact-grid">
    <address class="contact-card">
      <div class="contact-row"><small>Адрес</small><span class="contact-row__value">{address.full}</span><span class="muted">{address.near}</span></div>
      <div class="contact-row">
        <small>{phones.booking.purpose}</small><a class="contact-row__value" href={phones.booking.href}>{phoneText(phones.booking.label)}</a>
        <div class="contact-row__actions"><a class="chip chip--light" href={messengers.telegram}>Telegram</a><a class="chip chip--light" href={messengers.whatsapp}>WhatsApp</a></div>
      </div>
      <div class="contact-row"><small>{phones.events.purpose}</small><a class="contact-row__value" href={phones.events.href}>{phoneText(phones.events.label)}</a></div>
      <div class="contact-row"><small>Почта</small><a class="contact-row__value" href={`mailto:${company.email}`}>{company.email}</a></div>
      <div class="contact-row"><small>Работаем</small><span class="contact-row__value">{company.hours.label}</span><span class="muted">Заселение с {company.checkin}, выезд до {company.checkout}</span></div>
    </address>
    <div class="map-card">
      <LazyFrame class="map-card__frame" src={company.yandexMaps.mapWidget} title={`${company.name} на Яндекс Картах`} />
      <div class="map-card__pin">
        <span>{address.street}</span>
        <svg width="40" height="54" viewBox="0 0 40 54" aria-hidden="true"><path d="M20 0a20 20 0 0 1 20 20c0 16-20 34-20 34S0 36 0 20A20 20 0 0 1 20 0Z" fill="#E3A33B" /><circle cx="20" cy="20" r="7" fill="#232A20" /></svg>
      </div>
      <div class="map-card__actions"><Button href={company.yandexMaps.url} variant="forest">Маршрут в Яндекс Картах</Button></div>
    </div>
  </div>
</section>

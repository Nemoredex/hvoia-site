---
/**
 * Обычная картинка контента: WebP через astro:assets, srcset, lazy, размеры из исходника.
 * Ширины и sizes по умолчанию подобраны под сетки прототипа; тонкая настройка — этап 4 (PLAN.md).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  /** Декор: пустой alt + aria-hidden. */
  decorative?: boolean;
  style?: string;
}

const {
  src,
  alt,
  class: cls,
  sizes = '(max-width: 520px) 100vw, (max-width: 960px) 50vw, 33vw',
  widths,
  decorative = false,
  style,
} = Astro.props;

const list = (widths ?? [480, 800, 1200, 1600]).filter((w) => w <= src.width);
if (!list.includes(src.width) && list.length === 0) list.push(src.width);
---

<Image
  src={src}
  alt={decorative ? '' : alt}
  aria-hidden={decorative ? 'true' : undefined}
  class={cls}
  widths={list}
  sizes={sizes}
  loading="lazy"
  decoding="async"
  style={style}
/>

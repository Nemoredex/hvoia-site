---
/**
 * Яндекс Метрика. Включается переменной PUBLIC_METRIKA_ID при сборке; без неё на сайте нет ни строчки.
 * Счётчик грузится после load + простой браузера — не мешает LCP.
 * Цели: lead (заявка отправлена, LeadForm), phone, messenger, booking (клик по «Проверить даты»).
 * Вебвизор выключен по умолчанию: с ним политика ПДн должна прямо упоминать запись сессий.
 */
const id = import.meta.env.PUBLIC_METRIKA_ID;
---

{id && (
  <script is:inline define:vars={{ id: Number(id) }}>
    document.documentElement.dataset.metrika = String(id);
    function start() {
      (function (m, e, t, r, i, k, a) {
        m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
        m[i].l = 1 * new Date();
        k = e.createElement(t); a = e.getElementsByTagName(t)[0]; k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
      ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: false });
    }
    addEventListener('load', function () { ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(start); });
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a, button');
      if (!a || !window.ym) return;
      var h = a.getAttribute('href') || '';
      if (h.indexOf('tel:') === 0) ym(id, 'reachGoal', 'phone');
      else if (/t\.me|wa\.me/.test(h)) ym(id, 'reachGoal', 'messenger');
      else if (a.closest('[data-book-form]') && a.type === 'submit') ym(id, 'reachGoal', 'booking');
    });
  </script>
)}

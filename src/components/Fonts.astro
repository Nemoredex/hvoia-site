---
/**
 * Шрифты: Prata (заголовки) и Onest Variable (текст), только кириллица и латиница.
 *
 * - Onest — вариативный: один файл на все начертания 400/500/600 (было 6 файлов, стало 2, −16 КБ).
 * - preload — для кириллицы обоих шрифтов: без него браузер узнаёт о шрифте только после
 *   расчёта стилей, и текст первого экрана перерисовывается позже (Lighthouse: Network dependency tree).
 *   Латиница (цифры, кавычки) — без preload: небольшая и подгружается по unicode-range.
 * - @font-face пишем сами, а не через CSS @fontsource: там ещё 5 наборов (вьетнамский, математика…),
 *   которые сайту не нужны, но раздувают встроенный CSS.
 * Диапазоны unicode-range — из @fontsource (cyrillic / latin).
 */
import prataCyr from '@fontsource/prata/files/prata-cyrillic-400-normal.woff2?url';
import prataLat from '@fontsource/prata/files/prata-latin-400-normal.woff2?url';
import onestCyr from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import onestLat from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url';

const CYR = 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116';
const LAT =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const face = (family: string, url: string, range: string, weight: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${range}}`;

const css = [
  face('Prata', prataCyr, CYR, '400'),
  face('Prata', prataLat, LAT, '400'),
  face('Onest', onestCyr, CYR, '100 900'),
  face('Onest', onestLat, LAT, '100 900'),
].join('');
---

<link rel="preload" href={onestCyr} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={prataCyr} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />

---
/**
 * Всё SEO в <head>: title, description, canonical, robots, Open Graph, иконки, JSON-LD.
 * Подключается только из BaseLayout.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href } from '../lib/url';
import { SITE_NAME, THEME_COLOR, fullTitle, warnSeo } from '../lib/seo';
import type { PageSeo } from '../data/seo';
import defaultOgImage from '../assets/img/hero-home.webp';

export type JsonLd = Record<string, unknown>;

interface Props {
  seo: PageSeo;
  jsonLd?: JsonLd[];
  ogImage?: ImageMetadata;
  ogType?: 'website' | 'article';
}

const { seo, jsonLd = [], ogImage = defaultOgImage, ogType = 'website' } = Astro.props;

const title = fullTitle(seo.title, seo.noSuffix);
const path = Astro.url.pathname;
warnSeo(path, title, seo.description);

// Демо-сборка (GitHub Pages): PUBLIC_NOINDEX=true — закрываем все страницы от поисковиков,
// чтобы копия не попала в индекс раньше боевого сайта.
const isDemo = import.meta.env.PUBLIC_NOINDEX === 'true';
const robots = isDemo ? 'noindex, nofollow' : seo.noindex ? 'noindex, follow' : null;

// Canonical — абсолютный, на саму себя, со слэшем на конце (trailingSlash: 'always').
// У закрытых от индекса страниц canonical не нужен.
const canonical = seo.noindex ? null : new URL(path, Astro.site);

// OG-картинка 1200×630, JPEG: соцсети и мессенджеры не все понимают WebP.
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogImageUrl = new URL(og.src, Astro.site);
const ogUrl = canonical ?? new URL(path, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={seo.description} />
{canonical && <link rel="canonical" href={canonical} />}
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content={ogType} />
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
<link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
<link rel="manifest" href={href('/site.webmanifest')} />
<meta name="theme-color" content={THEME_COLOR} />
<meta name="color-scheme" content="light" />
<link rel="sitemap" href={href('/sitemap-index.xml')} />

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

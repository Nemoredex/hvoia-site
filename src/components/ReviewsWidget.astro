---
/**
 * Отзывы с Яндекс Карт — официальный виджет организации, грузится лениво (LazyFrame).
 * В JSON-LD рейтинг не выводим: виджет показывает его сам, а копировать цифры вручную — значит выдумывать.
 */
import LazyFrame from './LazyFrame.astro';
import company from '../data/company.json';
---

<LazyFrame class="reviews-frame" src={company.yandexMaps.reviewsWidget} title="Отзывы о гостевом доме «Хвоя» на Яндекс Картах">
  <a class="lazy-frame__fallback" href={company.yandexMaps.url}>Отзывы гостей на Яндекс Картах</a>
</LazyFrame>

---
/** Тёмная полоса с силуэтом леса сверху и снизу (.packages): тарифы, шаги, шатёр. */
import '../styles/parts/packages.css';
import Img from './Img.astro';
import branch from '../assets/img/decor/branch.webp';

interface Props {
  id?: string;
  left?: boolean;
  withBranch?: boolean;
}
const { id, left = false, withBranch = false } = Astro.props;
---

<section class="packages" id={id}>
  <div class="edge edge--top edge--trees edge--green" aria-hidden="true"></div>
  <div class="edge edge--bottom edge--trees edge--cream" aria-hidden="true"></div>
  {withBranch && <Img class="branch" src={branch} alt="" decorative max={420} quality={50} sizes="260px" style="left:-40px;bottom:-30px;width:260px;opacity:.16;transform:rotate(20deg)" />}
  <div class:list={['container', 'packages__inner', left && 'packages--left']}>
    <slot />
  </div>
</section>

---
/** Фото: порядок блоков — как в _materials/foto.html. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import SectionHead from '../components/SectionHead.astro';
import ReviewsWidget from '../components/ReviewsWidget.astro';
import LeadForm from '../components/LeadForm.astro';
import { pages } from '../data/seo';
import { imageGallery, imageUrl } from '../lib/schema';
import { gallery } from '../data/gallery';
import { heroes, photo } from '../data/images';
import company from '../data/company.json';
const items = await Promise.all(gallery.map(async (g) => ({ url: await imageUrl(photo(g.image), Astro.site), caption: g.caption ?? g.alt })));
const jsonLd = [imageGallery(Astro.site, items)];
---

<BaseLayout seo={pages.foto} jsonLd={jsonLd} ogImage={heroes.foto.src}>
  <PageHero
    path="/foto/"
    image={heroes.foto}
    edge="frame"
    headerCta="#contacts"
    title="Фото"
    lead="Дом, территория и праздники в разные сезоны."
  />
  <PhotoGallery />
  <section class="section container">
    <SectionHead title="Отзывы гостей" link={{ href: company.yandexMaps.url, label: 'Отзывы на Яндекс Картах' }} />
    <ReviewsWidget />
  </section>
  <LeadForm title="Расскажите, что планируете" />
</BaseLayout>
